@page
@model ScannerModel
@{
    ViewData["Title"] = "Scanner";
}

<main class="container scanner-container">
    <h1 class="page-title">Scanner</h1>
    
    <sl-card class="scanner-card">
        <div id="reader"></div>
        
        <div class="scanner-controls">
            <sl-button id="start-btn" variant="primary" class="btn-gradient">
                Start Scanner
            </sl-button>
            <sl-button id="stop-btn" variant="default" style="display: none;">
                Stop Scanner
            </sl-button>
        </div>
        
        <div id="result" class="result-container" style="display: none;"></div>
    </sl-card>
</main>

<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

<script>
    let html5QrCode = null;
    let isScanning = false;
    let lastScannedCode = null;
    let scanTimeout = null;
    let hideStatusInterval = null;

    const startBtn = document.getElementById('start-btn');
    const stopBtn = document.getElementById('stop-btn');
    const reader = document.getElementById('reader');
    const resultDiv = document.getElementById('result');

    html5QrCode = new Html5Qrcode("reader");

    async function handleScanSuccess(decodedText) {
        // Prevent duplicate scans
        if (lastScannedCode === decodedText) {
            return;
        }
        
        // Clear any timeout
        if (scanTimeout) {
            clearTimeout(scanTimeout);
        }
        
        lastScannedCode = decodedText;
        
        // Show result
        resultDiv.innerHTML = `<sl-alert variant="success" open>
            <strong>Scanned:</strong> ${decodedText}
        </sl-alert>`;
        resultDiv.style.display = 'block';
        
        // Vibrate if supported
        if (navigator.vibrate) {
            navigator.vibrate(200);
        }
        
        // Prevent duplicate scans for 2 seconds
        scanTimeout = setTimeout(() => {
            lastScannedCode = null;
        }, 2000);
    }

    startBtn.addEventListener('click', async () => {
        if (isScanning) return;

        try {
            resultDiv.style.display = 'none';
            lastScannedCode = null;
            
            // Clear any previous state
            html5QrCode.clear();
            
            await html5QrCode.start(
                { facingMode: "environment" },
                { 
                    fps: 10, 
                    qrbox: { width: 300, height: 300 },
                    disableFlip: false,
                    rememberLastUsedCamera: true
                },
                handleScanSuccess,
                (errorMessage) => {
                    // Ignore scanning errors (they happen frequently during scanning)
                }
            );
            
            isScanning = true;
            startBtn.style.display = 'none';
            stopBtn.style.display = 'inline-block';
            
            // Hide any status/paused messages that might appear
            setTimeout(() => {
                const allElements = reader.querySelectorAll('*');
                allElements.forEach(el => {
                    const text = el.textContent || el.innerText || '';
                    if (text && (text.toLowerCase().includes('paused') || 
                                 text.toLowerCase().includes('pause') ||
                                 text.toLowerCase().includes('scan paused'))) {
                        el.style.display = 'none';
                        el.style.visibility = 'hidden';
                        el.style.opacity = '0';
                        el.style.height = '0';
                        el.style.width = '0';
                    }
                });
            }, 200);
            
            // Continue hiding status messages periodically
            if (hideStatusInterval) {
                clearInterval(hideStatusInterval);
            }
            hideStatusInterval = setInterval(() => {
                if (!isScanning) {
                    clearInterval(hideStatusInterval);
                    hideStatusInterval = null;
                    return;
                }
                const allElements = reader.querySelectorAll('span, div');
                allElements.forEach(el => {
                    const text = (el.textContent || el.innerText || '').trim();
                    if (text && (text.toLowerCase().includes('paused') || 
                                 text.toLowerCase().includes('pause'))) {
                        el.style.display = 'none';
                        el.style.visibility = 'hidden';
                        el.remove();
                    }
                });
            }, 500);

        } catch (err) {
            console.error('Error starting scanner:', err);
            isScanning = false;
            resultDiv.innerHTML = `<sl-alert variant="danger" open>
                <strong>Error:</strong> Could not start scanner.
            </sl-alert>`;
            resultDiv.style.display = 'block';
        }
    });

    stopBtn.addEventListener('click', async () => {
        if (!isScanning) return;
        
        try {
            await html5QrCode.stop();
            html5QrCode.clear();
            
            isScanning = false;
            lastScannedCode = null;
            
            if (scanTimeout) {
                clearTimeout(scanTimeout);
                scanTimeout = null;
            }
            
            if (hideStatusInterval) {
                clearInterval(hideStatusInterval);
                hideStatusInterval = null;
            }
            
            startBtn.style.display = 'inline-block';
            stopBtn.style.display = 'none';
        } catch (err) {
            console.error('Error stopping scanner:', err);
        }
    });

    window.addEventListener('beforeunload', async () => {
        if (isScanning && html5QrCode) {
            try {
                await html5QrCode.stop();
            } catch (err) {}
        }
    });
</script>

<link rel="stylesheet" href="~/css/scanner.css" asp-append-version="true" />